/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - TIMPAY003S                                    */
/*                                                                   */
/* Program Narrative - Write one Item Time Payment record to         */
/*                     TPITEMSP - update when the item/source key    */
/*                     is on file, insert when it is not.            */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/30/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(TIMPAY003S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE LSCDEVLIBP/TIMPAY003S (
        IN INITEM CHAR(10),
        IN INSRCE CHAR(6),
        IN INPLAN CHAR(2),
        IN INEXPD DECIMAL(8, 0)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE ROWCNT INTEGER DEFAULT 0;
        DECLARE WKTODY DECIMAL(8, 0) DEFAULT 0;

        SET WKTODY = DEC(VARCHAR_FORMAT(CURRENT TIMESTAMP, 'YYYYMMDD'), 8, 0);

        IF INITEM IS NULL OR TRIM(INITEM) = ''
        OR INSRCE IS NULL OR TRIM(INSRCE) = '' THEN
            SIGNAL SQLSTATE '75012'
                SET MESSAGE_TEXT = 'Item number and source code are required';
        END IF;

        IF INPLAN IS NULL OR TRIM(INPLAN) = '' THEN
            SIGNAL SQLSTATE '75013'
                SET MESSAGE_TEXT = 'A time payment plan is required';
        END IF;

        IF INEXPD IS NULL OR INEXPD < WKTODY THEN
            SIGNAL SQLSTATE '75014'
                SET MESSAGE_TEXT = 'Expiration date must be today or later';
        END IF;

        /* GO-LIVE: writes go to the LSCDEVLIBP test copy of TPITEMSP -
           flip both statements (and TIMPAY001S C5/C6) to LSCPRDLIB */
        UPDATE LSCDEVLIBP/TPITEMSP
           SET TPPLAN = INPLAN,
               TPEXDATE = INEXPD
         WHERE TPITEM = INITEM
           AND TPSRCD = INSRCE;

        GET DIAGNOSTICS ROWCNT = ROW_COUNT;

        IF ROWCNT = 0 THEN
            INSERT INTO LSCDEVLIBP/TPITEMSP
                (TPITEM, TPSRCD, TPPLAN, TPEXDATE)
            VALUES (INITEM, INSRCE, INPLAN, INEXPD);
        END IF;
    END;
