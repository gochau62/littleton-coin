/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - TIMPAY003S                                    */
/*                                                                   */
/* Program Narrative - Write one Item Time Payment record to         */
/*                     TPITEMSP - update when the item/source key    */
/*                     is on file, insert when it is not.            */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/30/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(TIMPAY003S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE TIMPAY003S (
        IN INITEM CHAR(10),
        IN INSRCE CHAR(10),
        IN INPLAN CHAR(2),
        IN INEXPD DECIMAL(8, 0)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE ROWCNT INTEGER DEFAULT 0;

        IF INITEM IS NULL OR TRIM(INITEM) = ''
        OR INSRCE IS NULL OR TRIM(INSRCE) = '' THEN
            SIGNAL SQLSTATE '75012'
                SET MESSAGE_TEXT = 'An item number and source code are required to write a time payment record';
        END IF;

        IF INPLAN IS NULL OR TRIM(INPLAN) = '' THEN
            SIGNAL SQLSTATE '75013'
                SET MESSAGE_TEXT = 'A time payment plan is required to write a time payment record';
        END IF;

        IF INEXPD IS NULL
        OR INEXPD < DEC(VARCHAR_FORMAT(CURRENT TIMESTAMP, 'YYYYMMDD'), 8, 0) THEN
            SIGNAL SQLSTATE '75014'
                SET MESSAGE_TEXT = 'The expiration date must be a YYYYMMDD date on or after today';
        END IF;

        UPDATE LSCPRDLIB/TPITEMSP
           SET TIPLAN = INPLAN,
               TIEXPD = INEXPD
         WHERE TIITEM = INITEM
           AND TISRCE = INSRCE;

        GET DIAGNOSTICS ROWCNT = ROW_COUNT;

        IF ROWCNT = 0 THEN
            INSERT INTO LSCPRDLIB/TPITEMSP
                (TIITEM, TISRCE, TIPLAN, TIEXPD)
            VALUES (INITEM, INSRCE, INPLAN, INEXPD);
        END IF;
    END;
