/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - TIMPAY002S                                    */
/*                                                                   */
/* Program Narrative - Prices one item through the OE0337R item      */
/*                     price retrieval module, for the rows whose    */
/*                     plan column was left blank.  The parameter    */
/*                     list mirrors the program's Dcl-PR in          */
/*                     LSCARCLIB/QRPGLESRC mbr OE0337R: ten          */
/*                     parameters, item and source code the only     */
/*                     non-blank values passed (the way OP0800R      */
/*                     calls it), and the price passed back in       */
/*                     WKPRIC.  An SQL procedure rather than an      */
/*                     external registration so that compiling it    */
/*                     creates a program object like every other     */
/*                     proc, which is what the RFP promotes.         */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/30/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(TIMPAY002S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer - G Chau         Date - 09/01/2026                  |*/
/* |  Purpose - Parameter list tied out to OE0337R's source         |*/
/* |            (was a five parameter placeholder)                  |*/
/* |  Project - 230077                                              |*/
/* |                                                                |*/
/* | Programmer - G Chau         Date - 09/02/2026                  |*/
/* |  Purpose - SQL procedure calling OE0337R in place of the       |*/
/* |            external registration, which created no object      |*/
/* |            for the RFP to promote                              |*/
/* |  Project - 230077                                              |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE TIMPAY002S (
        INOUT WKITEM  CHAR(10),
        INOUT WKSELT  CHAR(10),
        INOUT WKSRCD  CHAR(6),
        INOUT WKPRIC  DECIMAL(9, 2),
        INOUT WKCPRC  DECIMAL(9, 2),
        INOUT WKDISC  DECIMAL(9, 2),
        INOUT WKADJC  CHAR(3),
        INOUT WKSHRV  DECIMAL(9, 0),
        INOUT WKCUST# DECIMAL(10, 0),
        INOUT WKMTLV  DECIMAL(3, 0)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        -- OE0337R is a plain RPG program, so it is called by name as declared
        CALL LSCPGMLIB/OE0337R(WKITEM, WKSELT, WKSRCD, WKPRIC, WKCPRC,
                               WKDISC, WKADJC, WKSHRV, WKCUST#, WKMTLV);
    END;
