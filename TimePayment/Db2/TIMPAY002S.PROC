/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - TIMPAY002S                                    */
/*                                                                   */
/* Program Narrative - Registers the item price retrieval module     */
/*                     OE0337R as a stored procedure, so the upload  */
/*                     can price an item the same way OP0800R does.  */
/*                                                                   */
/*                     When the plan column of the spreadsheet is    */
/*                     left blank, the upload calls this with the    */
/*                     item number and source code as the only       */
/*                     non-blank (or non-zero) parameters, and the   */
/*                     module passes the item price back out in      */
/*                     PRPRIC.  That price is then tied out to the   */
/*                     TPTIERSP ranges (TIMPAY001S type TIER) to     */
/*                     find the plan the item falls into.            */
/*                                                                   */
/*                     NOTE: the parameter list below mirrors how    */
/*                     OP0800R calls OE0337R and must be tied out    */
/*                     to the program's entry parameters before      */
/*                     compiling - the names here are only labels,   */
/*                     but the order, types and sizes have to match  */
/*                     the *PGM exactly or the call will blow up at  */
/*                     run time.                                     */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/30/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(TIMPAY002S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE TIMPAY002S (
        INOUT PRITEM CHAR(10),
        INOUT PRSRCC CHAR(10),
        INOUT PRCUS# CHAR(10),
        INOUT PRQTY  DECIMAL(5, 0),
        INOUT PRPRIC DECIMAL(9, 2)
        )

        LANGUAGE RPGLE
        SPECIFIC TIMPAY002S
        NOT DETERMINISTIC
        NO SQL
        EXTERNAL NAME 'LSCPRDLIB/OE0337R'
        PARAMETER STYLE GENERAL;
