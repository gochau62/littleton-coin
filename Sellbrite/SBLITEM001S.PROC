/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - SBLITEM001S                                   */
/*                                                                   */
/* Program Narrative - LCC item master lookup for the Sellbrite      */
/*                     Bulk Loader.  INTYPE picks the mode:          */
/*                       ITEM   - one exact SKU, everything below    */
/*                       SEARCH - type-ahead list for the SKU box,   */
/*                                SKU prefix match, capped at 50     */
/*                                                                   */
/*                     Given an LCC SKU, ITEM returns the            */
/*                     description, coin date, grades, comment and   */
/*                     root item from the production item master so  */
/*                     the loader can prefill the coin finder        */
/*                     instead of the operator retyping what LCC     */
/*                     already knows.  Prices, costs and on-hand     */
/*                     quantities are deliberately not returned:     */
/*                     those are LCC's internal figures, and the     */
/*                     listing takes its price from GreySheet.       */
/*                     Read only - the loader never writes to the    */
/*                     item master.                                  */
/*                                                                   */
/*                     DYNUSRPRF(*OWNER) so the procedure reads      */
/*                     LSCPRDLIB under its owner's authority; the    */
/*                     web user needs no authority to production.    */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/27/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(SBLITEM001S) COMMIT(*NONE)             */
/*                                                                   */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project - 260064                                              |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE SBLITEM001S (
        IN INTYPE VARCHAR(10),
        IN INKEY  VARCHAR(16)
        )

        LANGUAGE SQL
        READS SQL DATA
        DYNAMIC RESULT SETS 1
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        -- One row when the SKU is on the master, none when it is not.
        -- Every column here is CHAR, so nothing needs converting; the coded
        -- numeric columns (category, type, variety) are left out until their
        -- code tables are known - a raw code helps nobody.
        DECLARE C1 CURSOR WITH RETURN FOR
            SELECT TRIM(I.IISKU#) AS ITEM_SKU,
                   TRIM(I.IIDESC) AS ITEM_DESC,
                   TRIM(I.IICDAT) AS ITEM_DATE,
                   TRIM(I.IIGRAD) AS ITEM_GRADE,
                   TRIM(I.IIGRD2) AS ITEM_GRADE2,
                   TRIM(I.IIICMT) AS ITEM_COMMENT,
                   TRIM(I.IIROOT) AS ITEM_ROOT
              FROM LSCPRDLIB/ITMMSTP I
             WHERE I.IISKU# = INKEY
             FETCH FIRST 1 ROW ONLY;

        -- SEARCH feeds the SKU box's type-ahead list.  Prefix match on the
        -- item number only, the way the requisition screen searches it: the
        -- item number is the indexed key, so the production file stays fast.
        DECLARE C2 CURSOR WITH RETURN FOR
            SELECT TRIM(I.IISKU#) AS ITEM_SKU,
                   TRIM(I.IIDESC) AS ITEM_DESC,
                   TRIM(I.IICDAT) AS ITEM_DATE
              FROM LSCPRDLIB/ITMMSTP I
             WHERE UPPER(I.IISKU#) LIKE UPPER(INKEY) || '%'
             ORDER BY I.IISKU#
             FETCH FIRST 50 ROWS ONLY;

        IF INTYPE = 'SEARCH' THEN
            OPEN C2;
        ELSE
            OPEN C1;
        END IF;
    END;
