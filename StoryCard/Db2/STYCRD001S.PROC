/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - STYCRD001S                                    */
/*                                                                   */
/* Program Narrative - Story Card reads, one result set per type.    */
/*                                                                   */
/*                     CARDS - SKUs that have a story card, INKEY    */
/*                             narrows by leading characters         */
/*                             SCSKU, SCDESC, SCCARD                 */
/*                     ITEMS - the whole item master, INKEY narrows  */
/*                             SCSKU, SCDESC, SCCARD                 */
/*                     ONE   - one exact SKU, no row means it is not */
/*                             on the item master                    */
/*                             SCSKU, SCDESC, SCCARD                 */
/*                     CARD  - every body line held for INKEY        */
/*                             SCBLNO, SCBTXT, SCBSRK                */
/*                     FOOT  - the shared footer, key 1              */
/*                             SCFLNO, SCFTXT                        */
/*                                                                   */
/*                     SCCARD is Y when the SKU already has a card.  */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/27/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(STYCRD001S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE STYCRD001S (
        IN INTYPE VARCHAR(10),
        IN INKEY  VARCHAR(20)
        )

        LANGUAGE SQL
        READS SQL DATA
        DYNAMIC RESULT SETS 1
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE C1 CURSOR WITH RETURN FOR
            SELECT B.SCBSKU              AS SCSKU,
                   COALESCE(I.IIDESC,'') AS SCDESC,
                   'Y'                   AS SCCARD
              FROM (SELECT DISTINCT SCBSKU
                      FROM LSCPRDLIB/IVSCBODYP) B
              LEFT JOIN LSCPRDLIB/ITMMSTP I
                ON I.IISKU# = B.SCBSKU
             WHERE UPPER(B.SCBSKU) LIKE UPPER(INKEY) CONCAT '%'
             ORDER BY B.SCBSKU
             FETCH FIRST 200 ROWS ONLY;

        DECLARE C2 CURSOR WITH RETURN FOR
            SELECT I.IISKU#                            AS SCSKU,
                   I.IIDESC                            AS SCDESC,
                   CASE WHEN B.SCBSKU IS NULL
                        THEN 'N' ELSE 'Y' END          AS SCCARD
              FROM LSCPRDLIB/ITMMSTP I
              LEFT JOIN (SELECT DISTINCT SCBSKU
                           FROM LSCPRDLIB/IVSCBODYP) B
                ON B.SCBSKU = I.IISKU#
             WHERE UPPER(I.IISKU#) LIKE UPPER(INKEY) CONCAT '%'
             ORDER BY I.IISKU#
             FETCH FIRST 200 ROWS ONLY;

        DECLARE C3 CURSOR WITH RETURN FOR
            SELECT I.IISKU#                            AS SCSKU,
                   I.IIDESC                            AS SCDESC,
                   CASE WHEN B.SCBSKU IS NULL
                        THEN 'N' ELSE 'Y' END          AS SCCARD
              FROM LSCPRDLIB/ITMMSTP I
              LEFT JOIN (SELECT DISTINCT SCBSKU
                           FROM LSCPRDLIB/IVSCBODYP) B
                ON B.SCBSKU = I.IISKU#
             WHERE I.IISKU# = INKEY
             FETCH FIRST 1 ROW ONLY;

        DECLARE C4 CURSOR WITH RETURN FOR
            SELECT B.SCBLNO        AS SCBLNO,
                   RTRIM(B.SCBTXT) AS SCBTXT,
                   RTRIM(B.SCBSRK) AS SCBSRK
              FROM LSCPRDLIB/IVSCBODYP B
             WHERE B.SCBSKU = INKEY
             ORDER BY B.SCBLNO;

        DECLARE C5 CURSOR WITH RETURN FOR
            SELECT F.SCFLNO        AS SCFLNO,
                   RTRIM(F.SCFTXT) AS SCFTXT
              FROM LSCPRDLIB/IVSCFOOTP F
             WHERE F.SCFSKY = 1
             ORDER BY F.SCFLNO;

        IF INTYPE = 'CARDS' THEN
            OPEN C1;
        ELSEIF INTYPE = 'ITEMS' THEN
            OPEN C2;
        ELSEIF INTYPE = 'ONE' THEN
            OPEN C3;
        ELSEIF INTYPE = 'CARD' THEN
            OPEN C4;
        ELSEIF INTYPE = 'FOOT' THEN
            OPEN C5;
        ELSE
            SIGNAL SQLSTATE '75001'
                SET MESSAGE_TEXT = 'STYCRD001S type must be CARDS ITEMS ONE CARD or FOOT';
        END IF;
    END;
