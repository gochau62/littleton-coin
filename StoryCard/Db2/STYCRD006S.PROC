/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - STYCRD006S                                    */
/*                                                                   */
/* Program Narrative - Write one story card footer line, updating    */
/*                     the line when it is there and inserting it    */
/*                     when it is not.                               */
/*                     A footer key of 0 is read as key 1.           */
/*                     Text is trimmed to the file width of 50.      */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/27/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(STYCRD006S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE STYCRD006S (
        IN INSKY DECIMAL(7, 0),
        IN INLNO DECIMAL(4, 0),
        IN INTXT VARCHAR(100)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE ROWCNT INTEGER DEFAULT 0;
        DECLARE WKSKY  DECIMAL(7, 0);
        DECLARE WKTXT  CHAR(50);

        IF INLNO < 1 THEN
            SIGNAL SQLSTATE '75002'
                SET MESSAGE_TEXT = 'Footer line number must be 1 or more';
        END IF;

        SET WKSKY = COALESCE(NULLIF(INSKY, 0), 1);
        SET WKTXT = LEFT(COALESCE(INTXT, ''), 50);

        UPDATE LSCPRDLIB/IVSCFOOTP
           SET SCFTXT = WKTXT
         WHERE SCFSKY = WKSKY
           AND SCFLNO = INLNO;

        GET DIAGNOSTICS ROWCNT = ROW_COUNT;

        IF ROWCNT = 0 THEN
            INSERT INTO LSCPRDLIB/IVSCFOOTP
                (SCFSKY, SCFLNO, SCFTXT)
            VALUES (WKSKY, INLNO, WKTXT);
        END IF;
    END;
