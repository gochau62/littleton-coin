/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - STYCRD003S                                    */
/*                                                                   */
/* Program Narrative - Clear away story card lines that are no       */
/*                     longer wanted.                                */
/*                                                                   */
/*                     CARD - blank every body line for INSKU past   */
/*                            the end of each side.  INLN1 is the    */
/*                            last line kept on side 1, 0 when the   */
/*                            side is empty.  INLN2 is the last line */
/*                            kept on side 2, 12 when it is empty.   */
/*                            Lines are blanked and not deleted, so  */
/*                            a keyed read on SKU and line still     */
/*                            finds them.                            */
/*                     FOOT - delete every footer line past INLN1.   */
/*                            0 clears the footer.  INSKU and INLN2  */
/*                            are not used.                          */
/*                     DROP - delete every body line for INSKU.      */
/*                            INLN1 and INLN2 are not used.          */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/27/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(STYCRD003S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE STYCRD003S (
        IN INTYPE VARCHAR(10),
        IN INSKU  VARCHAR(20),
        IN INLN1  DECIMAL(4, 0),
        IN INLN2  DECIMAL(4, 0)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE WKS1 DECIMAL(4, 0);
        DECLARE WKS2 DECIMAL(4, 0);

        IF INTYPE IN ('CARD', 'DROP') THEN
            IF INSKU IS NULL OR TRIM(INSKU) = '' THEN
                SIGNAL SQLSTATE '75006'
                    SET MESSAGE_TEXT = 'A SKU is required to clear story card lines';
            END IF;
        END IF;

        IF INTYPE = 'CARD' THEN

            SET WKS1 = CASE WHEN INLN1 <  0 THEN  0
                            WHEN INLN1 > 12 THEN 12
                            ELSE INLN1 END;
            SET WKS2 = CASE WHEN INLN2 < 12 THEN 12
                            WHEN INLN2 > 22 THEN 22
                            ELSE INLN2 END;

            UPDATE LSCPRDLIB/IVSCBODYP
               SET SCBTXT = '',
                   SCBSRK = ''
             WHERE SCBSKU = INSKU
               AND ( (SCBLNO > WKS1 AND SCBLNO <= 12)
                  OR (SCBLNO > WKS2 AND SCBLNO <= 22) )
               AND (SCBTXT <> '' OR SCBSRK <> '');

        ELSEIF INTYPE = 'FOOT' THEN

            SET WKS1 = CASE WHEN INLN1 < 0 THEN 0 ELSE INLN1 END;

            DELETE FROM LSCPRDLIB/IVSCFOOTP
             WHERE SCFSKY = 1
               AND SCFLNO > WKS1;

        ELSEIF INTYPE = 'DROP' THEN

            DELETE FROM LSCPRDLIB/IVSCBODYP
             WHERE SCBSKU = INSKU;

        ELSE
            SIGNAL SQLSTATE '75007'
                SET MESSAGE_TEXT = 'STYCRD003S type must be CARD FOOT or DROP';
        END IF;
    END;
