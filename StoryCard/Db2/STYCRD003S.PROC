/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - STYCRD003S                                    */
/*                                                                   */
/* Program Narrative - Blank the story card body lines for INKEY     */
/*                     from INFROM up to line 21.                    */
/*                     This is the Access UpdateBlank                */
/*                     loop, which ran only after a save in update   */
/*                     mode, only from wherever side 2 finished, and */
/*                     only as far as line 21.                       */
/*                                                                   */
/*                     Nothing here deletes a record, the same as    */
/*                     the Access screens this replaces.             */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/27/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(STYCRD003S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE STYCRD003S (
        IN INKEY  VARCHAR(20),
        IN INFROM DECIMAL(4, 0)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        IF INKEY IS NULL OR TRIM(INKEY) = '' THEN
            SIGNAL SQLSTATE '75006'
                SET MESSAGE_TEXT = 'A SKU is required to blank story card lines';
        END IF;

        IF INFROM <= 21 THEN
            UPDATE IVSCBODYP
               SET SCBTXT = '',
                   SCBSRK = ''
             WHERE SCBSKU = INKEY
               AND SCBLNO >= INFROM
               AND SCBLNO <= 21
               AND (SCBTXT <> '' OR SCBSRK <> '');
        END IF;
    END;
