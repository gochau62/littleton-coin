/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - STYCRD007S                                    */
/*                                                                   */
/* Program Narrative - Drop the tail of the footer.  Removes every    */
/*                     line past the last one written.                */
/*                                                                   */
/*                     The Access footer screen had nothing like      */
/*                     this: it only ever updated line for line, so   */
/*                     cutting a four line footer down to two left    */
/*                     lines three and four in the file and they went */
/*                     on printing on every card.                     */
/*                                                                   */
/*                     Footer lines are deleted rather than blanked,  */
/*                     unlike the body, because the footer is one     */
/*                     shared block read end to end rather than a     */
/*                     fixed set of positions on a printed side.      */
/*                                                                   */
/*                     A last line of 0 clears the footer completely. */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/27/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(STYCRD007S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE STYCRD007S (
        IN INSKY  DECIMAL(7, 0),
        IN INLAST DECIMAL(4, 0)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE WKSKY  DECIMAL(7, 0);
        DECLARE WKLAST DECIMAL(4, 0);

        SET WKSKY  = COALESCE(NULLIF(INSKY, 0), 1);
        SET WKLAST = CASE WHEN INLAST < 0 THEN 0 ELSE INLAST END;

        DELETE FROM LSCPRDLIB/IVSCFOOTP
         WHERE SCFSKY = WKSKY
           AND SCFLNO > WKLAST;
    END;
