/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - STYCRD007S                                    */
/*                                                                   */
/* Program Narrative - Delete every story card footer line past the  */
/*                     last one written.  A last line of 0 clears    */
/*                     the footer completely.                        */
/*                     A footer key of 0 is read as key 1.           */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/27/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(STYCRD007S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE STYCRD007S (
        IN INSKY  DECIMAL(7, 0),
        IN INLAST DECIMAL(4, 0)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE WKSKY  DECIMAL(7, 0);
        DECLARE WKLAST DECIMAL(4, 0);

        SET WKSKY  = COALESCE(NULLIF(INSKY, 0), 1);
        SET WKLAST = CASE WHEN INLAST < 0 THEN 0 ELSE INLAST END;

        DELETE FROM LSCPRDLIB/IVSCFOOTP
         WHERE SCFSKY = WKSKY
           AND SCFLNO > WKLAST;
    END;
