/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - STYCRD008S                                    */
/*                                                                   */
/* Program Narrative - Delete a whole story card, every body line    */
/*                     held for the SKU.  Backs out a new card whose */
/*                     save failed part way, and serves the Delete   */
/*                     button on the maintenance screen.             */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/27/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(STYCRD008S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE STYCRD008S (
        IN INSKU VARCHAR(20)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        IF INSKU IS NULL OR TRIM(INSKU) = '' THEN
            SIGNAL SQLSTATE '75003'
                SET MESSAGE_TEXT = 'A SKU is required to delete a story card';
        END IF;

        DELETE FROM LSCPRDLIB/IVSCBODYP
         WHERE SCBSKU = INSKU;
    END;
