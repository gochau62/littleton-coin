/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - STYCRD004S                                    */
/*                                                                   */
/* Program Narrative - Write one story card body line.  Updates the   */
/*                     line if it is there and inserts it if it is    */
/*                     not, so the caller no longer runs a COUNT(*)   */
/*                     per line first the way the Access CheckLineMode*/
/*                     routine did.                                   */
/*                                                                   */
/*                     Line numbers are bound to the printed card:    */
/*                     1-12 is side 1 and 13-22 is side 2.  Anything  */
/*                     outside that is rejected rather than written,  */
/*                     which is what the old "<= 11" and "<= 21"      */
/*                     guards were reaching for and getting wrong.    */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/27/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(STYCRD004S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE STYCRD004S (
        IN INSKU VARCHAR(20),
        IN INLNO DECIMAL(4, 0),
        IN INTXT VARCHAR(100),
        IN INSRK VARCHAR(30)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE ROWCNT INTEGER DEFAULT 0;
        DECLARE WKTXT  CHAR(50);
        DECLARE WKSRK  CHAR(15);

        IF INLNO < 1 OR INLNO > 22 THEN
            SIGNAL SQLSTATE '75001'
                SET MESSAGE_TEXT = 'Story card line number must be 1 to 22';
        END IF;

        -- the file columns are fixed CHAR, so trim to width here and the
        -- caller never has to worry about an over long line failing the bind
        SET WKTXT = LEFT(COALESCE(INTXT, ''), 50);
        SET WKSRK = LEFT(COALESCE(INSRK, ''), 15);

        UPDATE LSCPRDLIB/IVSCBODYP
           SET SCBTXT = WKTXT,
               SCBSRK = WKSRK
         WHERE SCBSKU = INSKU
           AND SCBLNO = INLNO;

        GET DIAGNOSTICS ROWCNT = ROW_COUNT;

        IF ROWCNT = 0 THEN
            INSERT INTO LSCPRDLIB/IVSCBODYP
                (SCBSKU, SCBLNO, SCBTXT, SCBSRK)
            VALUES (INSKU, INLNO, WKTXT, WKSRK);
        END IF;
    END;
