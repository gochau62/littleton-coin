/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - PRPGMRASGT.TABLE                              */
/*                                                                   */
/* Program Narrative - Create Project Programmers File               */
/*                     The extra programmers on a project, each      */
/*                     with a work status and scheduled start of     */
/*                     their own. The project's own programmer       */
/*                     stays on PRPROJP as the primary.              */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 09/11/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(QSQLSRC)                    */
/*                     SRCMBR(PRPGMRASGT) COMMIT(*NONE)              */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project - 260082                                              |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE TABLE PRPGMRASGT(
 PGAPROJ   DECIMAL(6, 0) WITH DEFAULT NOT NULL,        -- Project Number
 PGAPGMR   CHAR(10) CCSID 37 WITH DEFAULT NOT NULL,    -- Programmer Profile
 PGAWRKSTS CHAR(3) CCSID 37 WITH DEFAULT NOT NULL,     -- Work Status Code PRSTATUSP
 PGASTRDTE DECIMAL(8, 0) WITH DEFAULT NOT NULL,        -- Scheduled Start  20260911
 PGAADDUSR CHAR(10) CCSID 37 WITH DEFAULT NOT NULL,    -- Added By
 PGAADDDTE DECIMAL(8, 0) WITH DEFAULT NOT NULL,        -- Added Date  20260911
 PGAADDTME DECIMAL(6, 0) WITH DEFAULT NOT NULL,        -- Added Time  HHMMSS
 PGACHGUSR CHAR(10) CCSID 37 WITH DEFAULT NOT NULL,    -- Changed By
 PGACHGDTE DECIMAL(8, 0) WITH DEFAULT NOT NULL,        -- Changed Date  20260911
 PGACHGTME DECIMAL(6, 0) WITH DEFAULT NOT NULL,        -- Changed Time  HHMMSS
 PRIMARY KEY (PGAPROJ, PGAPGMR))
 RCDFMT PRPGMRASGR;

LABEL ON TABLE PRPGMRASGT IS 'Project Programmers File';

-- The dashboard reads every assignment by programmer.
CREATE INDEX PRPGMRASGX ON PRPGMRASGT (PGAPGMR);

LABEL ON COLUMN PRPGMRASGT
( PGAPROJ   TEXT IS 'Project Number',
  PGAPGMR   TEXT IS 'Programmer Profile',
  PGAWRKSTS TEXT IS 'Work Status Code',
  PGASTRDTE TEXT IS 'Scheduled Start Date',
  PGAADDUSR TEXT IS 'Added By',
  PGAADDDTE TEXT IS 'Added Date',
  PGAADDTME TEXT IS 'Added Time',
  PGACHGUSR TEXT IS 'Changed By',
  PGACHGDTE TEXT IS 'Changed Date',
  PGACHGTME TEXT IS 'Changed Time');
