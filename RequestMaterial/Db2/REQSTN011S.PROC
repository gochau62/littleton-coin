/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - REQSTN011S                                    */
/*                                                                   */
/* Program Narrative - The requisitions raised for one requestor,     */
/*                     newest first, one row each rather than one     */
/*                     row a line. Feeds My Requisitions on the       */
/*                     entry form, where the work floor looks up      */
/*                     what it asked for and prints a copy without    */
/*                     the maintenance screen, which it is not        */
/*                     authorized for.                                */
/*                     RDLINES is how many lines the requisition      */
/*                     has and RDOPEN how many of those are still     */
/*                     out, so a requisition reads as finished or     */
/*                     not without its lines being fetched.           */
/*                     Capped at the most recent two hundred, which   */
/*                     is years of requisitions for one person.       */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 08/25/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(REQSTN011S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE REQSTN011S (
        IN INNAME VARCHAR(50)
        )

        LANGUAGE SQL
        READS SQL DATA
        DYNAMIC RESULT SETS 1
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE C1 CURSOR WITH RETURN FOR
            SELECT H.RHREQ#, H.RHNAME, H.RHRQDT, H.RHRQTM,
                   H.RHARCD, H.RHARTY, H.RHRUSH, H.RHAUTB, H.RHCMNT,
                   COUNT(D.RDLIN#) AS RDLINES,
                   COALESCE(SUM(CASE WHEN D.RDLIN# IS NOT NULL
                                      AND D.RDRTNF <> 'Y'
                                     THEN 1 ELSE 0 END), 0) AS RDOPEN
              FROM RQSREQHDRT H
              LEFT JOIN RQSREQDTLT D
                ON D.RDREQ# = H.RHREQ#
             WHERE UPPER(TRIM(H.RHNAME)) = UPPER(TRIM(INNAME))
             GROUP BY H.RHREQ#, H.RHNAME, H.RHRQDT, H.RHRQTM,
                      H.RHARCD, H.RHARTY, H.RHRUSH, H.RHAUTB, H.RHCMNT
             ORDER BY H.RHREQ# DESC
             FETCH FIRST 200 ROWS ONLY;

        OPEN C1;
    END;
