/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - REQSTN010S                                    */
/*                                                                   */
/* Program Narrative - Correct one Requisition line from the station */
/*                     grid: item number, location, description,     */
/*                     quantity and the data entry name. A NULL      */
/*                     parameter leaves that column unchanged, so    */
/*                     the grid can save one box at a time as it is  */
/*                     left.                                         */
/*                     The data entry name is the requestor's full   */
/*                     name, which is the Inv DE Number on the       */
/*                     screen. The old system kept only the first    */
/*                     four letters of the first name because the    */
/*                     column was ten characters; it holds fifty     */
/*                     now, so the whole name is kept.               */
/*                     It is not the requestor's badge - that is a   */
/*                     number and lives on the header in RHBDGE.     */
/*                     Cost, retail and the returned flag are not    */
/*                     touched here - the Return Item box owns the   */
/*                     flag and the money columns come from the item */
/*                     master when the line is first entered.        */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 08/05/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(REQSTN010S) COMMIT(*NONE)              */
/*                     DFTRDBCOL(LSCDEVLIBP)                         */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project - 260074                                              |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE REQSTN010S (
        IN INREQ#  DECIMAL(9, 0),
        IN INLIN#  DECIMAL(3, 0),
        IN INITEM  VARCHAR(16),
        IN INLOC   VARCHAR(3),
        IN INDESC  VARCHAR(50),
        IN INQTY   DECIMAL(9, 0),
        IN INBDGE  VARCHAR(50)
        )

        LANGUAGE SQL
        MODIFIES SQL DATA
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        UPDATE RQSREQDTLT
           SET RDITEM = COALESCE(INITEM, RDITEM),
               RDLOC  = COALESCE(INLOC,  RDLOC),
               RDDESC = COALESCE(INDESC, RDDESC),
               RDBDGE = COALESCE(INBDGE, RDBDGE),
               RDQTY  = CASE WHEN INQTY IS NULL THEN RDQTY
                             WHEN INQTY > 0     THEN INQTY
                             ELSE RDQTY
                        END
         WHERE RDREQ# = INREQ#
           AND ( INLIN# = 0 OR RDLIN# = INLIN# );
    END;
