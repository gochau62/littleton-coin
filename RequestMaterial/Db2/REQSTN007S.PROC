/*-------------------------------------------------------------------*/
/*                                                                   */
/* Program Name      - REQSTN007S                                    */
/*                                                                   */
/* Program Narrative - The one lookup procedure. INTYPE picks the    */
/*                     list:                                         */
/*                       AREACODE/AREATYPE/NAMES/AUTHBY - active     */
/*                         rows of that type from RQSCODEFLT         */
/*                       BADGE - live active-employee list (badge #  */
/*                         + name) from the production employee      */
/*                         file; always current, nothing to seed     */
/*                       ITEM - entry-form autofill for INKEY:       */
/*                         description, coin date, average cost and  */
/*                         price, all of it straight off the ITMMSTP */
/*                         item master, which is the one source for  */
/*                         what an item is and what it is worth      */
/*                       ITEMSRCH - type-ahead search over the       */
/*                         ITMMSTP item master (every inventory      */
/*                         item, not just previously requisitioned) */
/*                                                                   */
/* Author            - G Chau                                        */
/*                     Littleton Coin Company                        */
/*                     Littleton NH                                  */
/*                                                                   */
/* Date Written      - 07/20/2026                                    */
/* Run Instructions  - RUNSQLSTM SRCFILE(LSCDEVLIBP/QSQLSRC)         */
/*                     SRCMBR(REQSTN007S)                            */
/*********************************************************************/
/*                                                                   */
/* __________________________________________________________________*/
/* |                  Maintenance History                           |*/
/* |                                                                |*/
/* | Programmer -                Date -                             |*/
/* |  Purpose -                                                     |*/
/* |  Project -                                                     |*/
/* |                                                                |*/
/* ------------------------------------------------------------------*/
/*                                                                   */
/*-------------------------------------------------------------------*/

CREATE OR REPLACE PROCEDURE REQSTN007S (
        IN INTYPE VARCHAR(10),
        IN INKEY  VARCHAR(16)
        )

        LANGUAGE SQL
        READS SQL DATA
        DYNAMIC RESULT SETS 1
        SET OPTION DBGVIEW = *SOURCE, DYNUSRPRF = *OWNER

    BEGIN
        DECLARE C1 CURSOR WITH RETURN FOR
            SELECT CDCODE, CDDESC
              FROM RQSCODEFLT
             WHERE CDTYPE = INTYPE
               AND CDACTV = 'Y'
             ORDER BY CDDESC, CDCODE;

        DECLARE C2 CURSOR WITH RETURN FOR
            SELECT TRIM(I.IIDESC) AS RDDESC,
                   COALESCE(NULLIF(TRIM(CHAR(I.IICDAT)), '0'), '') AS RDCNDT,
                   I.IIAVGC AS RDCOST,
                   I.IIPRCE AS RDRETL
              FROM LSCPRDLIB/ITMMSTP I
             WHERE I.IISKU# = INKEY
             FETCH FIRST 1 ROW ONLY;

        DECLARE C3 CURSOR WITH RETURN FOR
            SELECT TRIM(I.IISKU#) AS RDITEM,
                   TRIM(I.IIDESC) AS RDDESC,
                   COALESCE(NULLIF(TRIM(CHAR(I.IICDAT)), '0'), '') AS RDCNDT,
                   I.IIAVGC AS RDCOST,
                   I.IIPRCE AS RDRETL
              FROM LSCPRDLIB/ITMMSTP I
             WHERE UPPER(I.IISKU#) LIKE UPPER(INKEY) || '%'
             ORDER BY I.IISKU#
             FETCH FIRST 200 ROWS ONLY;

        DECLARE C4 CURSOR WITH RETURN FOR
            SELECT TRIM(CHAR(INT(E.LEBADGE))) AS CDCODE,
                   TRIM(E.LEFNAME) || ' ' || TRIM(E.LELNAME) AS CDDESC
              FROM LSCPRDLIB/XEMPLOYP E
             WHERE E.LEESTAT = 'A'
             ORDER BY 2, 1;

        DECLARE C5 CURSOR WITH RETURN FOR
            SELECT CDCODE, CDDESC FROM (
                SELECT TRIM(CHAR(INT(E.LEBADGE))) AS CDCODE,
                       TRIM(E.LEFNAME) || ' ' || TRIM(E.LELNAME) AS CDDESC,
                       1 AS PREF
                  FROM LSCPRDLIB/XEMPLOYP E
                 WHERE E.LEESTAT = 'A'
                   AND ( UPPER(SUBSTR(TRIM(E.LEFNAME), 1, 1) ||
                               TRIM(E.LELNAME)) = UPPER(TRIM(INKEY))
                      OR ( LENGTH(TRIM(INKEY)) = 10
                           AND UPPER(SUBSTR(TRIM(E.LEFNAME), 1, 1) ||
                                     TRIM(E.LELNAME)) LIKE UPPER(TRIM(INKEY)) || '%' ) )
                UNION ALL
                SELECT '' AS CDCODE,
                       TRIM(CASE WHEN LOCATE(' - ', U.TEXT_DESCRIPTION) > 1
                                 THEN SUBSTR(U.TEXT_DESCRIPTION, 1,
                                             LOCATE(' - ', U.TEXT_DESCRIPTION) - 1)
                                 ELSE U.TEXT_DESCRIPTION
                            END) AS CDDESC,
                       2 AS PREF
                  FROM QSYS2.USER_INFO U
                 WHERE U.AUTHORIZATION_NAME = UPPER(TRIM(INKEY))
                   AND U.TEXT_DESCRIPTION IS NOT NULL
                   AND TRIM(U.TEXT_DESCRIPTION) <> ''
            ) W
             ORDER BY PREF
             FETCH FIRST 1 ROW ONLY;

        IF INTYPE = 'ITEM' THEN
            OPEN C2;
        ELSEIF INTYPE = 'ITEMSRCH' THEN
            OPEN C3;
        ELSEIF INTYPE = 'BADGE' THEN
            OPEN C4;
        ELSEIF INTYPE = 'WHOAMI' THEN
            OPEN C5;
        ELSE
            OPEN C1;
        END IF;
    END;
